# Local editor / agent state
.codex
.DS_Store

# Build intermediates
build/

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Reference PDFs are usually large and may have licensing constraints.
# Keep bibliographic notes and OCR markdown in git; keep PDF originals local by default.
references/pdfs/**/*.pdf

# Legacy local OCR corpus kept out of git after the project-structure rebuild.
reference/

# OCR output can be committed selectively when it is clean and useful.
# Leave this pattern commented unless the OCR corpus becomes too large.
# references/ocr-md/**/*.md
